# Application Configuration
APP_ENV=development
APP_DOMAIN=localhost:8000
PORT=8000

# Database Configuration
DBURL=postgresql://postgres:password@localhost:5432/ntmonitor?sslmode=disable

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# SMTP Configuration (for sending emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@ntmonitor.com

# Notes:
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env file to git
# 3. For production (Railway), set these as environment variables in Railway dashboard
# 4. Generate JWT_SECRET with: openssl rand -hex 32
